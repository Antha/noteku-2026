<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_additem"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/teal_200"
        tools:context=".ui.MainActivity">

        <!-- Input item -->
        <EditText
            android:id="@+id/edt_dialog_newitem_todo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example : Wash Clothes"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:layout_marginBottom="12dp"
            android:textSize="13sp"/>

        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/active_time_options"
            android:layout_marginBottom="16dp"
            android:id="@+id/spinner_option"
            android:background="@drawable/spinner_background_purple"
            />

        <!-- Label -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Time"
            android:textStyle="bold"
            android:textColor="#37474F"
            android:layout_marginBottom="8dp"/>

        <!-- Date & Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:scaleX="0.9"
            android:scaleY="0.9">

            <DatePicker
                android:id="@+id/datePicker"
                android:layout_width="match_parent"
                android:layout_height="143dp"
                android:calendarViewShown="false"
                android:datePickerMode="spinner"
                android:spinnersShown="true"
                android:textSize="8sp"
                android:visibility="gone"
                android:background="@drawable/bg_timepicker_teal"
                android:theme="@style/CustomDatePickerStyle"
                android:layout_marginBottom="5dp"
                />

            <TimePicker
                android:id="@+id/timePicker"
                android:layout_width="match_parent"
                android:layout_height="129dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_timepicker_teal"
                android:textSize="10sp"
                android:theme="@style/CustomTimePickerStyle"
                android:timePickerMode="spinner" />
        </LinearLayout>

        <!-- Radio Group -->
        <RadioGroup
            android:id="@+id/radio_group_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radioDaily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/radioSpecificDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Specific Day"
                />
        </RadioGroup>

        <!-- Days of the week -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:id="@+id/grid_days_of_week"
            android:visibility="gone"
            >

            <CheckBox android:text="Sun"  android:textSize="10sp"/>
            <CheckBox android:text="Mon"  android:textSize="10sp"/>
            <CheckBox android:text="Tue"  android:textSize="10sp"/>
            <CheckBox android:text="Wed"  android:textSize="10sp"/>
            <CheckBox android:text="Thur"  android:textSize="10sp"/>
            <CheckBox android:text="Fri"  android:textSize="10sp"/>
            <CheckBox android:text="Sat"  android:textSize="10sp"/>
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <CheckBox
                android:id="@+id/chkEnableVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice"/>
            <CheckBox
                android:id="@+id/chkEnableVibra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vibration"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:padding="10dp"
            android:visibility="gone"
            />

        <!-- Action buttons -->
        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btn_batal_dialog_newitem_todo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@color/purple_200"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                />

            <Button
                android:id="@+id/btn_simpan_dialog_newitem_todo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:layout_margin="5dp"
                android:background="@color/purple_700"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
