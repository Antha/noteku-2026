<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/purple_200"
    tools:context=".ui.MainActivity">

    <!-- Task input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_dialog_edit_item_todo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type your task"
            android:textColor="@color/black"/>
    </com.google.android.material.textfield.TextInputLayout>

    <Spinner
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/active_time_options"
        android:layout_marginBottom="16dp"
        android:id="@+id/spinner_option"
        android:background="@drawable/spinner_background"
        />

    <!-- Label -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active Time"
        android:textStyle="bold"
        android:textColor="@color/purple_700"
        android:layout_marginBottom="8dp"/>

    <!-- Date & Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:scaleX="0.9"
        android:scaleY="0.9">

        <DatePicker
            android:id="@+id/datePicker_editItem"
            android:layout_width="match_parent"
            android:layout_height="143dp"
            android:calendarViewShown="false"
            android:datePickerMode="spinner"
            android:spinnersShown="true"
            android:textSize="8sp"
            android:theme="@style/CustomDatePickerStyle"
            android:visibility="gone"
            android:background="@drawable/bg_timepicker"
            android:layout_marginBottom="5dp"
            />

        <TimePicker
            android:id="@+id/timePicker_editItem"
            android:layout_width="match_parent"
            android:layout_centerInParent="true"
            android:timePickerMode="spinner"
            android:layout_height="140dp"
            android:theme="@style/CustomTimePickerStyle"
            android:background="@drawable/bg_timepicker"
            android:layout_marginBottom="10dp"
            />
    </LinearLayout>

    <!-- Radio Group -->
    <RadioGroup
        android:id="@+id/radio_group_repeat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/radioDaily"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/radioSpecificDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Specific Day"
            android:visibility="invisible"
            />
    </RadioGroup>

    <!-- Days of the week -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:id="@+id/grid_days_of_week"
        android:visibility="gone"
        >

        <CheckBox android:text="Sun"  android:textSize="10sp"/>
        <CheckBox android:text="Mon"  android:textSize="10sp"/>
        <CheckBox android:text="Tue"  android:textSize="10sp"/>
        <CheckBox android:text="Wed"  android:textSize="10sp"/>
        <CheckBox android:text="Thur"  android:textSize="10sp"/>
        <CheckBox android:text="Fri"  android:textSize="10sp"/>
        <CheckBox android:text="Sat"  android:textSize="10sp"/>
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <CheckBox
            android:id="@+id/chkEnableVoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice"/>
        <CheckBox
            android:id="@+id/chkEnableVibra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vibration"/>
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_batal_dialog_edit_item_todos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:backgroundTint="@color/teal_200"
            android:textColor="@color/black"
            android:textSize="12sp"
            />

        <Button
            android:id="@+id/btn_hapus_dialog_edit_item_todos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/purple_500"
            android:textColor="@color/white"
            android:textSize="12sp"
            />

        <Button
            android:id="@+id/btn_update_dialog_edit_item_todos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/teal_700"
            android:textColor="@color/white"
            android:textSize="12sp"
            />
    </LinearLayout>
</LinearLayout>
