<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tool="http://schemas.android.com/tools"
    android:layout_margin="3dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="5dp"
    app:cardElevation="4dp"
    >

    <LinearLayout
        android:id="@+id/container_item"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/name_itemtodo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Test"
                android:textSize="12sp"
                android:textColor="#CACACA"
                />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_weight="1"
                android:text="Active Time"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_active_tIme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Active TIme"
                android:textSize="8sp"
                android:layout_marginBottom="5dp"
                />

            <TextView
                android:id="@+id/tv_period_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="daily"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_badge_daily"
                android:gravity="center"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:id="@+id/btn_edt_itemtodo"
                android:src="@drawable/ic_baseline_create_24"
                android:layout_gravity="right"
                />
            <Switch
                android:id="@+id/stoActive"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text=""
                android:thumbTint="@color/teal_700"
                android:trackTint="@color/teal_200"
                android:scaleX="0.6"
                android:scaleY="0.6"
                android:layout_gravity="right"
                />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>