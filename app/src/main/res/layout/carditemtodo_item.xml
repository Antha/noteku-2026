<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tool="http://schemas.android.com/tools"
    android:layout_margin="3dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="5dp"
    app:cardElevation="4dp"
    >

    <LinearLayout
        android:id="@+id/container_item"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/name_itemtodo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Test"
                android:textSize="12sp"
                android:textColor="#CACACA"
                />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_weight="1"
                android:text="Active Time"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_active_tIme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Active TIme"
                android:textSize="8sp"
                android:layout_marginBottom="5dp"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_period_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="daily"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_daily"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginEnd="5dp"
                    />
                <ImageView
                    android:id="@+id/tv_isvibra"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/baseline_vibration_24"
                    android:background="@drawable/bg_rounded_text_teal"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:padding="1dp"
                    />
                <ImageView
                    android:id="@+id/tv_isvoice"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/baseline_keyboard_voice_24"
                    android:background="@drawable/bg_rounded_text_teal"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:padding="1dp"
                    />
            </LinearLayout>

            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp"
                android:columnCount="4"
                >
                <TextView
                    android:id="@+id/tv_day_mon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mon"
                    android:textColor="@android:color/white"
                    android:textSize="7sp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_sd_mon"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    />

                <TextView
                    android:id="@+id/tv_day_tue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tue"
                    android:textColor="@android:color/white"
                    android:textSize="7sp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_sd_tue"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    />

                <TextView
                    android:id="@+id/tv_day_wed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wed"
                    android:textColor="@android:color/white"
                    android:textSize="7sp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_sd_wed"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    />

                <TextView
                    android:id="@+id/tv_day_thu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thu"
                    android:textColor="@android:color/white"
                    android:textSize="7sp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_sd_thu"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    />

                <TextView
                    android:id="@+id/tv_day_fri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fri"
                    android:textColor="@android:color/white"
                    android:textSize="7sp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_sd_fri"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    />

                <TextView
                    android:id="@+id/tv_day_sat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sat"
                    android:textColor="@android:color/white"
                    android:textSize="7sp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_sd_sat"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    />

                <TextView
                    android:id="@+id/tv_day_sun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sun"
                    android:textColor="@android:color/white"
                    android:textSize="7sp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_badge_sd_sun"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    />
            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:id="@+id/btn_edt_itemtodo"
                android:src="@drawable/ic_baseline_create_24"
                android:layout_gravity="right"
                />
            <Switch
                android:id="@+id/stoActive"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text=""
                android:thumbTint="@color/teal_700"
                android:trackTint="@color/teal_200"
                android:scaleX="0.6"
                android:scaleY="0.6"
                android:layout_gravity="right"
                />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>